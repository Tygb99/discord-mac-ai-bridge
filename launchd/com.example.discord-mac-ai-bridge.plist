<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.discord-mac-ai-bridge</string>
  <key>ProgramArguments</key><array><string>__BUN__</string><string>__REPO__/bridge.ts</string><string>--keeper</string></array>
  <key>EnvironmentVariables</key><dict><key>HOME</key><string>__HOME__</string><key>LANG</key><string>en_US.UTF-8</string></dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/discord-mac-ai-bridge.keeper.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/discord-mac-ai-bridge.keeper.log</string>
</dict></plist>
